(* Unit level alarms (SOO section 3); maintenance masks the other alarms (3.2.7) *)
CHS_DEV_H_C (Condition := ACH_RUN AND ((CHS_T01 > CHS_TSP_OUT + CHS_TSP_OUT_plus) OR (CHS_T02 > CHS_TSP_OUT + CHS_TSP_OUT_plus)),
             SP_Condition_Delay := CHS_DEV_TM, SEC_P := SEC_P, Condition_OK => ALM_CHS_DEV_H);
CHS_DEV_L_C (Condition := ACH_RUN AND ((CHS_T01 < CHS_TSP_OUT - CHS_TSP_OUT_plus) OR (CHS_T02 < CHS_TSP_OUT - CHS_TSP_OUT_plus)),
             SP_Condition_Delay := CHS_DEV_TM, SEC_P := SEC_P, Condition_OK => ALM_CHS_DEV_L);
