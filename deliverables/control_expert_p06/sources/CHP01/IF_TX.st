(* Pack status block %MW700..729, NOE IO Scanning writes it to SMCL %MW400.. *)
IF SEC_P THEN
    TX_HB := TX_HB + 1;
    IF TX_HB > 30000 THEN TX_HB := 0; END_IF;
END_IF;
TX_BITS1 := 0;
IF ACH_RUN THEN TX_BITS1 := TX_BITS1 OR 16#0001; END_IF;
IF CHP_RUN THEN TX_BITS1 := TX_BITS1 OR 16#0002; END_IF;
IF UNIT_ENABLE THEN TX_BITS1 := TX_BITS1 OR 16#0004; END_IF;
IF ACH_Fault THEN TX_BITS1 := TX_BITS1 OR 16#0008; END_IF;
IF CHWP_Fault THEN TX_BITS1 := TX_BITS1 OR 16#0010; END_IF;
IF CH_MS THEN TX_BITS1 := TX_BITS1 OR 16#0020; END_IF;
IF ACH_PWR THEN TX_BITS1 := TX_BITS1 OR 16#0040; END_IF;
IF ACH_AM THEN TX_BITS1 := TX_BITS1 OR 16#0080; END_IF;
IF CHP_REM THEN TX_BITS1 := TX_BITS1 OR 16#0100; END_IF;
IF Chiller_Start_ENA[4] THEN TX_BITS1 := TX_BITS1 OR 16#0200; END_IF;
IF Chiller_Stop_ENA[5] THEN TX_BITS1 := TX_BITS1 OR 16#0400; END_IF;
IF FPM_ENA[0] THEN TX_BITS1 := TX_BITS1 OR 16#0800; END_IF;
IF Chemical_Mode_ENA[0] THEN TX_BITS1 := TX_BITS1 OR 16#1000; END_IF;
IF TST_MS THEN TX_BITS1 := TX_BITS1 OR 16#2000; END_IF;
IF DISCH_ALM THEN TX_BITS1 := TX_BITS1 OR 16#4000; END_IF;
TX_BITS2 := 0;
IF ALM_CHBPV_MM THEN TX_BITS2 := TX_BITS2 OR 16#0001; END_IF;
IF ALM_CHV01_MM THEN TX_BITS2 := TX_BITS2 OR 16#0002; END_IF;
IF ALM_CHV02_MM THEN TX_BITS2 := TX_BITS2 OR 16#0004; END_IF;
IF ALM_CHV03_MM THEN TX_BITS2 := TX_BITS2 OR 16#0008; END_IF;
IF ALM_CHP_MM THEN TX_BITS2 := TX_BITS2 OR 16#0010; END_IF;
IF ALM_ACH_MM THEN TX_BITS2 := TX_BITS2 OR 16#0020; END_IF;
IF ACH_F1 THEN TX_BITS2 := TX_BITS2 OR 16#0040; END_IF;
IF ACHF_F THEN TX_BITS2 := TX_BITS2 OR 16#0080; END_IF;
IF CHP_FLT_DI OR VFD_ALM THEN TX_BITS2 := TX_BITS2 OR 16#0100; END_IF;
IF COMM_ACH_FAIL THEN TX_BITS2 := TX_BITS2 OR 16#0200; END_IF;
IF COMM_VFD_FAIL THEN TX_BITS2 := TX_BITS2 OR 16#0400; END_IF;
IF COMM_TST_FAIL THEN TX_BITS2 := TX_BITS2 OR 16#0800; END_IF;
IF PHTS_FLT THEN TX_BITS2 := TX_BITS2 OR 16#1000; END_IF;
IF ALM_FPM_LOWFL THEN TX_BITS2 := TX_BITS2 OR 16#2000; END_IF;
IF TST_NOCAP THEN TX_BITS2 := TX_BITS2 OR 16#4000; END_IF;
TX_TSTMODE := TST_MODE;
TX_RUNH_HI := DINT_TO_INT(CH_RUNH / 10000);
TX_RUNH_LO := DINT_TO_INT(CH_RUNH MOD 10000);
TX_ACHH_HI := DINT_TO_INT(ACH_RUNH / 10000);
TX_ACHH_LO := DINT_TO_INT(ACH_RUNH MOD 10000);
TX_TSTCAP := REAL_TO_INT(TST_CAP * 100.0);
TX_CHST01 := REAL_TO_INT(CHS_T01 * 100.0);
TX_CHST02 := REAL_TO_INT(CHS_T02 * 100.0);
TX_CHSFL01 := REAL_TO_INT(CHS_FL01 * 10.0);
TX_CHSFL02 := 0;      (* no CHS-FL02 in the I/O list, reserved *)
TX_CHRFL01 := REAL_TO_INT(CHR_FL01 * 10.0);
TX_CHINT01 := REAL_TO_INT(CHIN_T01 * 100.0);
TX_CHRT01 := REAL_TO_INT(CHR_T01 * 100.0);
TX_VSDFB := REAL_TO_INT(CHPVSD_FB * 100.0);
TX_CHV01FB := REAL_TO_INT(CHV01_FB * 100.0);
TX_CHV02FB := REAL_TO_INT(CHV02_FB * 100.0);
TX_CHV03FB := REAL_TO_INT(CHV03_FB * 100.0);
TX_CHBPVFB := REAL_TO_INT(CHBPV_FB * 100.0);
TX_TSPECHO := REAL_TO_INT(CHS_TSP_OUT * 100.0);
TX_SPDECHO := REAL_TO_INT(CHPVSD_C * 100.0);
(* 2026-10-19: b0 = enable command held by this unit (ACH_EN); the SMCL takes the stage back from it after a restart *)
TX_ENAFB := 0;
IF ACH_EN THEN TX_ENAFB := 1; END_IF;

(* Line 2 write area is allocated by the NOE row by row as %MW730..759; copy the same status block *)
TX2_BLK[0] := TX_HB;
TX2_BLK[1] := TX_BITS1;
TX2_BLK[2] := TX_BITS2;
TX2_BLK[3] := TX_TSTMODE;
TX2_BLK[4] := TX_RUNH_HI;
TX2_BLK[5] := TX_RUNH_LO;
TX2_BLK[6] := TX_ACHH_HI;
TX2_BLK[7] := TX_ACHH_LO;
TX2_BLK[8] := TX_TSTCAP;
TX2_BLK[9] := TX_CHST01;
TX2_BLK[10] := TX_CHST02;
TX2_BLK[11] := TX_CHSFL01;
TX2_BLK[12] := TX_CHSFL02;
TX2_BLK[13] := TX_CHRFL01;
TX2_BLK[14] := TX_CHINT01;
TX2_BLK[15] := TX_CHRT01;
TX2_BLK[16] := TX_VSDFB;
TX2_BLK[17] := TX_CHV01FB;
TX2_BLK[18] := TX_CHV02FB;
TX2_BLK[19] := TX_CHV03FB;
TX2_BLK[20] := TX_CHBPVFB;
TX2_BLK[21] := TX_TSPECHO;
TX2_BLK[22] := TX_SPDECHO;
TX2_BLK[23] := TX_ENAFB;
FOR I := 24 TO 29 DO TX2_BLK[I] := 0; END_FOR;

(* P06 extension: same 30-word status block, previously reserved +24/+25. *)
P06_TX_VER := 2606;
P06_TX_EXT := 0;
IF P06_SeqFault THEN P06_TX_EXT := P06_TX_EXT OR 16#0001; END_IF;
IF UNIT_ENABLE AND NOT P06_SeqFault AND NOT P06_ConfigFault AND NOT TST_MS
    AND NOT LOCAL_EN AND P06_TempValid AND (P06_State = 0) AND P06_TOff.Q
    AND NOT ACH_RUN AND NOT CHP_RUN THEN
    P06_TX_EXT := P06_TX_EXT OR 16#0002;
END_IF;
IF (P06_State = 40) AND P06_TOn.Q THEN P06_TX_EXT := P06_TX_EXT OR 16#0004; END_IF;
IF P06_TempValid THEN P06_TX_EXT := P06_TX_EXT OR 16#0008; END_IF;
IF P06_StopFault THEN P06_TX_EXT := P06_TX_EXT OR 16#0010; END_IF;
IF CHE_DUE THEN P06_TX_EXT := P06_TX_EXT OR 16#0020; END_IF;
IF LOCAL_EN THEN P06_TX_EXT := P06_TX_EXT OR 16#0040; END_IF;
(* Report the selected VALID temperature twice, never a failed held channel. *)
IF NOT (CHS_T01_UnderRange OR CHS_T01_OverRange) THEN P06_QualTemp := CHS_T01; END_IF;
IF NOT (CHS_T02_UnderRange OR CHS_T02_OverRange) THEN
    IF CHS_T01_UnderRange OR CHS_T01_OverRange THEN P06_QualTemp := CHS_T02;
    ELSE P06_QualTemp := MAX(P06_QualTemp, CHS_T02);
    END_IF;
END_IF;
TX_CHST01 := REAL_TO_INT(P06_QualTemp * 100.0);
TX_CHST02 := TX_CHST01;
TX2_BLK[9] := TX_CHST01; TX2_BLK[10] := TX_CHST02;
TX2_BLK[24] := P06_TX_VER; TX2_BLK[25] := P06_TX_EXT;
