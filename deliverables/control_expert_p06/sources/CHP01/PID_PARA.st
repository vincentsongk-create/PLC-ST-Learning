(* PID external interface: PARA / MODE fields of the three PID blocks come from PID_<name>_* (SCADA writable).
   halt = PID not enabled by the sequence (OUT_ARB, previous scan) OR operator halt.
   Fix: the original Main FBD MOVE blocks wrote halt := enable, i.e. the PIDs were frozen exactly while needed. *)
(* MINFL: bypass valve minimum flow *)
CHPBV_MinFL_PID_OP_PAPR.gain := PID_MINFL_GAIN;
CHPBV_MinFL_PID_OP_PAPR.ti := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_MINFL_TI, 100000.0) * 1000.0));
CHPBV_MinFL_PID_OP_PAPR.td := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_MINFL_TD, 100000.0) * 1000.0));
CHPBV_MinFL_PID_OP_PAPR.td_lag := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_MINFL_TD_LAG, 100000.0) * 1000.0));
CHPBV_MinFL_PID_OP_PAPR.ymax := PID_MINFL_YMAX;
CHPBV_MinFL_PID_OP_PAPR.ymin := PID_MINFL_YMIN;
CHPBV_MinFL_PID_OP_Mode.en_p := PID_MINFL_EN_P;
CHPBV_MinFL_PID_OP_Mode.en_i := PID_MINFL_EN_I;
CHPBV_MinFL_PID_OP_Mode.halt := (NOT CHPPV_MinFL_Enable) OR PID_MINFL_HALT;
(* CHWDT: charging chiller inlet temperature *)
CHPPV_MinCHWDT_PID_PARA.gain := PID_CHWDT_GAIN;
CHPPV_MinCHWDT_PID_PARA.ti := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_CHWDT_TI, 100000.0) * 1000.0));
CHPPV_MinCHWDT_PID_PARA.td := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_CHWDT_TD, 100000.0) * 1000.0));
CHPPV_MinCHWDT_PID_PARA.td_lag := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_CHWDT_TD_LAG, 100000.0) * 1000.0));
CHPPV_MinCHWDT_PID_PARA.ymax := PID_CHWDT_YMAX;
CHPPV_MinCHWDT_PID_PARA.ymin := PID_CHWDT_YMIN;
CHPPV_MinCHWDT_PID_Mode.en_p := PID_CHWDT_EN_P;
CHPPV_MinCHWDT_PID_Mode.en_i := PID_CHWDT_EN_I;
CHPPV_MinCHWDT_PID_Mode.halt := (NOT CHPPV_MinCHWDT_Enable) OR PID_CHWDT_HALT;
(* TSTFL: charging tank flow *)
CHPPV_MinTST_FL_PID_PAPR.gain := PID_TSTFL_GAIN;
CHPPV_MinTST_FL_PID_PAPR.ti := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_TSTFL_TI, 100000.0) * 1000.0));
CHPPV_MinTST_FL_PID_PAPR.td := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_TSTFL_TD, 100000.0) * 1000.0));
CHPPV_MinTST_FL_PID_PAPR.td_lag := DINT_TO_TIME(REAL_TO_DINT(LIMIT(0.0, PID_TSTFL_TD_LAG, 100000.0) * 1000.0));
CHPPV_MinTST_FL_PID_PAPR.ymax := PID_TSTFL_YMAX;
CHPPV_MinTST_FL_PID_PAPR.ymin := PID_TSTFL_YMIN;
CHPPV_MinTST_FL_PID_MODE.en_p := PID_TSTFL_EN_P;
CHPPV_MinTST_FL_PID_MODE.en_i := PID_TSTFL_EN_I;
CHPPV_MinTST_FL_PID_MODE.halt := (NOT CHPPV_MinTST_FL_Enable) OR PID_TSTFL_HALT;
