(* ---- alarm memory over a cold start (2026-10-19) ----
   ALM_MEM (%MW3000.., kept with 'Initialize %MWi on cold start' off) = HMI_X of the last scan.
   First scan after a cold start (ALM_MEM_DONE = FALSE) with a matching layout signature ALM_SIG:
   the alarms active before the power loss stay active for ALM_HOLD_TM s, until the live alarm comes
   back by itself, or until an alarm reset; latched alarms go back into their latch variable. *)
IF NOT ALM_MEM_DONE THEN
    ALM_MEM_DONE := TRUE;
    ALM_HOLD := ALM_SIG = 6516;
    ALM_HOLD_CNT := 0;
    IF ALM_HOLD_TM <= 0 THEN ALM_HOLD_TM := 1200; END_IF;
    FOR HMI_K := 0 TO 1167 DO
        ALM_OLD[HMI_K] := ALM_HOLD AND ((ALM_MEM[HMI_K / 16] AND SHL(16#0001, INT_TO_UINT(HMI_K MOD 16))) <> 0);
    END_FOR;
    IF ALM_HOLD THEN
        ALM_SYSFL := ALM_OLD[1153];
        ALM_LEAD_FAIL := ALM_OLD[1156];
        ALM_HSBY_SWAP := ALM_OLD[1158];
    END_IF;
END_IF;
IF ALM_HOLD AND SEC_P THEN ALM_HOLD_CNT := ALM_HOLD_CNT + 1; END_IF;
IF (ALM_HOLD_CNT >= ALM_HOLD_TM) OR (RST_HOLD > 0) THEN ALM_HOLD := FALSE; END_IF;

