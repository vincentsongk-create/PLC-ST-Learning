(* 2026-10-19 restart after a power loss of both SMCL CPUs:
   a cold start resets every variable (CH_ENA, STAGE_REQ, System_ENA ...) -> RCV_DONE = FALSE; a warm start sets %S1.
   S40 then sends the command blocks without the valid bit (b5): the M340s keep their state as on comm loss.
   When every M340 has sent a fresh status block (or after RCV_TM s) S30 takes the enabled units back from
   the M340 enable echo (status word +23 b0) and sets the stage count to that number. *)
IF (NOT RCV_DONE) OR %S1 THEN
    RCV_DONE := TRUE;
    RCV_ACT := TRUE;
    RCV_CNT := 0;
    RCV_HB0[1] := CH1_STS_HB; RCV_SEEN[1] := FALSE;
    RCV_HB0[2] := CH2_STS_HB; RCV_SEEN[2] := FALSE;
    RCV_HB0[3] := CH3_STS_HB; RCV_SEEN[3] := FALSE;
    RCV_HB0[4] := CH4_STS_HB; RCV_SEEN[4] := FALSE;
    RCV_HB0[5] := CH5_STS_HB; RCV_SEEN[5] := FALSE;
END_IF;

TRIG_1S (CLK := %S6);
SEC_P := TRIG_1S.Q;

IF SEC_P THEN
    HB_SMCL := HB_SMCL + 1;
    IF HB_SMCL > 30000 THEN HB_SMCL := 0; END_IF;
END_IF;
