CH_ALMW[1] := CH1_STS_BITS2;
TST_MODE[1] := CH1_STS_TSTMODE;
CH_RUNH[1] := INT_TO_REAL(CH1_STS_RUNH_HI) * 10000.0 + INT_TO_REAL(CH1_STS_RUNH_LO);
ACH_RUNH[1] := INT_TO_REAL(CH1_STS_ACHH_HI) * 10000.0 + INT_TO_REAL(CH1_STS_ACHH_LO);
TST_CAP[1] := INT_TO_REAL(CH1_STS_TSTCAP) / 100.0;
ACH_ENA_FB[1] := (CH1_STS_ENAFB AND 16#0001) <> 0;
SPD_ECHO[1] := INT_TO_REAL(CH1_STS_SPDECHO) / 100.0;
(* 2026-10-20 user: unit supply temperature for the unit selection / handover (user edit had CHST01 twice) *)
CH_STS_CHST[1] := MAX(IN1 := INT_TO_REAL(CH1_STS_CHST01) / 100.0, IN2 := INT_TO_REAL(CH1_STS_CHST02) / 100.0);

