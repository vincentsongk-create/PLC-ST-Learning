(* ---- Summary ---- *)
N_RUN := 0; N_PUMP := 0; N_EN := 0; N_CHG := 0; N_COMM := 0;
FOR I := 1 TO 5 DO
    IF I > N_CH_CFG THEN
        COMM_OK[I] := FALSE;
    END_IF;
    CH_FAULT[I] := COMM_OK[I] AND (ACH_FLT[I] OR CHWP_FLT[I] OR ((CH_ALMW[I] AND 16#003F) <> 0));
    ALM_COMM_CH[I] := (I <= N_CH_CFG) AND NOT COMM_OK[I];
    (* M340: power loss = chiller fault and unit not available (UNIT_EN=0); ignoring power, a unit without power is still available (waiting for quick restart) *)
    AVLB_NOPWR[I] := COMM_OK[I] AND (UNIT_EN[I] OR NOT CH_PWR[I]) AND NOT CH_MS[I] AND NOT RESTART_FAIL[I];
    AVLB[I] := AVLB_NOPWR[I] AND CH_PWR[I];
    (* 2026-10-22 user: no temperature here; the own supply temperature is checked when a unit counts as started (S30 N_EFF_DONE) *)
    EFF_OK[I] := CH_ENA[I] AND AVLB_NOPWR[I] AND NOT ROT_OUT[I];
    IF ACH_S[I] AND COMM_OK[I] THEN N_RUN := N_RUN + 1; END_IF;
    IF CHWP_S[I] AND COMM_OK[I] THEN N_PUMP := N_PUMP + 1; END_IF;
    IF CH_ENA[I] THEN N_EN := N_EN + 1; END_IF;
    IF COMM_OK[I] THEN N_COMM := N_COMM + 1; END_IF;
    IF COMM_OK[I] AND (TST_MODE[I] = 4) THEN N_CHG := N_CHG + 1; END_IF;
END_FOR;

