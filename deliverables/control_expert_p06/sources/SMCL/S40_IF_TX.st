(* Pack the command blocks for the 5 M340s at %MW200.. (read by the M340s with IO Scanning) *)
IF ECPU_HSBY_1.LOCAL_HSBY_STS.PLC_A = ECPU_HSBY_1.LOCAL_HSBY_STS.RUN_PRIMARY THEN
    SMCL_PRIM := 1;
ELSE
    SMCL_PRIM := 2;
END_IF;
FOR I := 1 TO 5 DO
    OTHER_CHEM[I] := FALSE;
    FOR J := 1 TO 5 DO
        IF (J <> I) AND COMM_OK[J] AND CHEM_ACT[J] THEN OTHER_CHEM[I] := TRUE; END_IF;
    END_FOR;
END_FOR;

(* ---- Chiller 1 ACH-01(CHA-E03) %MW200..219 ---- *)
CH1_CMD_HB := HB_SMCL;
CH1_CMD_BITS := 0;
IF CH_ENA[1] THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0001; END_IF;
IF OTHER_CHEM[1] THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0002; END_IF;
IF CHS_ON THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0004; END_IF;
IF RST_HOLD > 0 THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0008; END_IF;
IF LEAD_ID = 1 THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0010; END_IF;
IF NOT RCV_ACT AND P06_Known[1] AND P06_Fresh[1] AND NOT P06_Local[1] THEN CH1_CMD_BITS := CH1_CMD_BITS OR 16#0020; END_IF;      (* command block valid (cleared during the restart recovery) *)
CH1_CMD_SPD := REAL_TO_INT(CHPVSD_SEQ_OUT * 100.0);
CH1_CMD_TSP := REAL_TO_INT(CHS_TSP_OUT * 100.0);
CH1_CMD_CHWST := REAL_TO_INT(CHWS_T01_T02 * 100.0);
CH1_CMD_OAT := REAL_TO_INT(OA_T * 100.0);
CH1_CMD_PRIM := SMCL_PRIM;

