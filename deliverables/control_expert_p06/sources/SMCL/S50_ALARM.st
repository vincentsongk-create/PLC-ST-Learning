(* SMCL level alarms (SOO section 3); unit alarms come from the M340 via the status words *)
DLY_CHWSDEV (IN := (N_RUN > 0) AND ((OK_CHWS_T01 AND (ABS(V_CHWS_T01 - CHS_TSP_OUT) > CHWS_DEV))
                    OR (OK_CHWS_T02 AND (ABS(V_CHWS_T02 - CHS_TSP_OUT) > CHWS_DEV))),
             PT_S := CHWS_DEV_TM, Q => ALM_CHWS_DEV);
DLY_TLOW (IN := (OK_CHWS_T01 AND (V_CHWS_T01 < LOOP_T_LOW)) OR (OK_CHWS_T02 AND (V_CHWS_T02 < LOOP_T_LOW))
              OR (OK_CHWR_T01 AND (V_CHWR_T01 < LOOP_T_LOW)) OR (OK_CHWR_T02 AND (V_CHWR_T02 < LOOP_T_LOW)),
          PT_S := 10, Q => ALM_LOOP_TLOW);
DLY_TOTFL (IN := (N_RUN > 0) AND (TOT_CHF > CHF_HL), PT_S := CHF_HL_TD, Q => ALM_TOTFL_HL);
DLY_LDISP (IN := LOAD_DISP > LOAD_DISP_PCT, PT_S := LOAD_DISP_TM, Q => ALM_LOAD_DISP);
DLY_LTIT (IN := (Server_LOAD > 0.0) AND (SYS_LOAD < Server_LOAD), PT_S := 60, Q => ALM_LOAD_LT_IT);

ALM_SNS_ANY := ALM_SNS_CHWS_FL01 OR ALM_SNS_CHWR_FL01 OR ALM_SNS_CHWS_T01 OR ALM_SNS_CHWR_T01
            OR ALM_SNS_CHWS_P01 OR ALM_SNS_CHWR_P01 OR ALM_SNS_CHWS_FL02 OR ALM_SNS_CHWR_FL02
            OR ALM_SNS_CHWS_T02 OR ALM_SNS_CHWR_T02 OR ALM_SNS_CHWS_P02 OR ALM_SNS_CHWR_P02;
FOR I := 1 TO 19 DO
    IF ALM_SNS_CA_T[I] OR ALM_SNS_CA_H[I] THEN ALM_SNS_ANY := TRUE; END_IF;
END_FOR;

(* Hot standby switchover *)
IF (PRIM_LAST <> 0) AND (SMCL_PRIM <> PRIM_LAST) THEN ALM_HSBY_SWAP := TRUE; END_IF;
PRIM_LAST := SMCL_PRIM;
ALM_HSBY_LINK := ECPU_HSBY_1.LOCAL_HSBY_STS.HSBY_LINK_ERROR;

ALM_COMM_ANY := FALSE; ALM_CH_ANY := FALSE;
FOR I := 1 TO 5 DO
    IF ALM_COMM_CH[I] THEN ALM_COMM_ANY := TRUE; END_IF;
    IF CH_FAULT[I] THEN ALM_CH_ANY := TRUE; END_IF;
END_FOR;

IF SEC_P AND (RST_HOLD > 0) THEN RST_HOLD := RST_HOLD - 1; END_IF;
IF ALM_RESET THEN
    RST_HOLD := 3;     (* hold the reset bit 3 s so M340 IO Scanning sees it *)
    ALM_HSBY_SWAP := FALSE;
    ALM_SYSFL := FALSE;
    ALM_RESET := FALSE;
END_IF;

