(* Test only: SIM_M340_EN=TRUE simulates the 5 M340s reading the command blocks and writing back the status blocks.
   With real M340s connected SIM_M340_EN must stay FALSE. *)
IF SIM_M340_EN THEN
    IF SEC_P THEN SIM_HB := SIM_HB + 1; IF SIM_HB > 30000 THEN SIM_HB := 0; END_IF; END_IF;
END_IF;

IF SIM_M340_EN THEN
    (* ---- Sim ACH-01(CHA-E03) ---- *)
    IF (CH1_CMD_BITS AND 16#0020) <> 0 THEN SIM_ENA[1] := (CH1_CMD_BITS AND 16#0001) <> 0; END_IF;   (* valid block only *)
    IF SIM_PWRLOSS[1] OR SIM_FAULT[1] OR SIM_MS[1] OR NOT SIM_ENA[1] THEN
        SIM_RUN[1] := FALSE; SIM_CNT[1] := 0;
    ELSE
        IF SEC_P AND (SIM_CNT[1] < SIM_START_TM) THEN SIM_CNT[1] := SIM_CNT[1] + 1; END_IF;
        SIM_RUN[1] := SIM_CNT[1] >= SIM_START_TM;
    END_IF;
    IF SIM_RUN[1] AND SEC_P THEN SIM_RT_S[1] := SIM_RT_S[1] + SIM_RT_SPEED; END_IF;
    IF NOT SIM_COMMLOSS[1] THEN
        CH1_STS_HB := SIM_HB;
    END_IF;
    SIM_B1 := 0;
    IF SIM_RUN[1] THEN SIM_B1 := SIM_B1 OR 16#0003 OR 16#0200; END_IF;      (* ACH_S CHP_S start done *)
    IF NOT (SIM_FAULT[1] OR SIM_MS[1]) THEN SIM_B1 := SIM_B1 OR 16#0004; END_IF;   (* UNIT_ENABLE *)
    IF SIM_FAULT[1] THEN SIM_B1 := SIM_B1 OR 16#0008; END_IF;
    IF SIM_MS[1] THEN SIM_B1 := SIM_B1 OR 16#0020; END_IF;
    IF NOT SIM_PWRLOSS[1] THEN SIM_B1 := SIM_B1 OR 16#0040; END_IF;
    SIM_B1 := SIM_B1 OR 16#0180;                                              (* remote *)
    IF SIM_CHEM[1] THEN SIM_B1 := SIM_B1 OR 16#1000; END_IF;
    CH1_STS_BITS1 := SIM_B1;
    CH1_STS_BITS2 := 0;
    IF SIM_CHG[1] THEN CH1_STS_TSTMODE := 4; ELSIF SIM_RUN[1] THEN CH1_STS_TSTMODE := 2; ELSE CH1_STS_TSTMODE := 1; END_IF;
    SIM_RTH := SIM_RT_S[1] / 3600;
    CH1_STS_RUNH_HI := DINT_TO_INT(SIM_RTH / 10000);
    CH1_STS_RUNH_LO := DINT_TO_INT(SIM_RTH MOD 10000);
    CH1_STS_ACHH_HI := CH1_STS_RUNH_HI;
    CH1_STS_ACHH_LO := CH1_STS_RUNH_LO;
    CH1_STS_TSTCAP := 9000;
    CH1_STS_TSPECHO := CH1_CMD_TSP;
    CH1_STS_SPDECHO := CH1_CMD_SPD;
    CH1_STS_ENAFB := 0;
    IF SIM_ENA[1] THEN CH1_STS_ENAFB := 1; END_IF;
END_IF;

